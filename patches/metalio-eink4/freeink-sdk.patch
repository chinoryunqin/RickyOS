diff --git a/libs/hardware/MetalioCamera/src/MetalioCamera.cpp b/libs/hardware/MetalioCamera/src/MetalioCamera.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fe36687e926612b8cc59627e73ed5221d564c995
--- /dev/null
+++ b/libs/hardware/MetalioCamera/src/MetalioCamera.cpp
@@ -0,0 +1,106 @@
+#include "MetalioCamera.h"
+
+#include <esp_heap_caps.h>
+#include <esp_log.h>
+#include <hal/clk_gate_ll.h>
+#include <soc/rtc_cntl_struct.h>
+#include <soc/usb_dwc_struct.h>
+#include <soc/usb_serial_jtag_struct.h>
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+
+#include "CameraPower.h"
+
+namespace freeink::metalio_camera {
+namespace {
+UsbBusyProbe busyProbe = nullptr;
+bool used = false;
+constexpr uint32_t kDiagnosticMagic = 0x55564347;
+RTC_NOINIT_ATTR Diagnostic retained;
+RTC_NOINIT_ATTR uint32_t diagnosticMagic, diagnosticInverse;
+vprintf_like_t previousPrintf = nullptr;
+int captureUsbError(const char* format, va_list args) {
+  char line[192];
+  va_list copy;
+  va_copy(copy, args);
+  vsnprintf(line, sizeof(line), format, copy);
+  va_end(copy);
+  if (strstr(line, "usb") || strstr(line, "USB") || strstr(line, "enum") || strstr(line, "HUB")) {
+    const size_t used = strnlen(retained.usbError, sizeof(retained.usbError));
+    if (used < sizeof(retained.usbError) - 1)
+      snprintf(retained.usbError + used, sizeof(retained.usbError) - used, "%s", line);
+  }
+  return previousPrintf ? previousPrintf(format, args) : 0;
+}
+void finishDiagnostic(esp_err_t result) {
+  retained.result = result;
+  retained.internalAfter = heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
+  retained.largestAfter = heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
+}
+}  // namespace
+Diagnostic diagnostic() {
+  return diagnosticMagic == kDiagnosticMagic && diagnosticInverse == ~kDiagnosticMagic ? retained : Diagnostic{};
+}
+void setUsbBusyProbe(UsbBusyProbe probe) { busyProbe = probe; }
+bool usbBusy() { return busyProbe && busyProbe(); }
+bool needsRestart() { return used; }
+esp_err_t capture(UsbUvcStill::JpegBuffer& jpeg, UsbUvcStill::DetectInfo& info) {
+  if (usbBusy()) return ESP_ERR_INVALID_STATE;
+  retained = {};
+  diagnosticInverse = ~kDiagnosticMagic;
+  diagnosticMagic = kDiagnosticMagic;
+  retained.internalBefore = heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
+  retained.largestBefore = heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
+  readPowerStatus(retained.powerBefore);
+  retained.phase = 1;
+  esp_err_t result = powerOn();
+  if (result != ESP_OK) {
+    finishDiagnostic(result);
+    return result;
+  }
+  used = true;
+  retained.phase = 2;
+  if (!selectCamera()) {
+    powerOff();
+    finishDiagnostic(ESP_FAIL);
+    return ESP_FAIL;
+  }
+  delay(80);
+  readPowerStatus(retained.powerAfter);
+  previousPrintf = esp_log_set_vprintf(captureUsbError);
+  retained.phase = 3;
+  result = UsbUvcStill::StartSession(8000);
+  if (result == ESP_OK) {
+    retained.phase = 4;
+    result = UsbUvcStill::Detect(info, 3000);
+  }
+  if (result == ESP_OK) {
+    retained.phase = 5;
+    result = UsbUvcStill::CaptureOne(jpeg, 20000);
+  }
+  // A failed Host installation can already have gated OTG. Do not read
+  // peripheral registers without its clock; retain an explicit sentinel.
+  const bool clockOn = (DPORT_READ_PERI_REG(periph_ll_get_clk_en_reg(PERIPH_USB_MODULE)) &
+                        periph_ll_get_clk_en_mask(PERIPH_USB_MODULE)) != 0;
+  retained.hostPort = clockOn ? USB_DWC.hprt_reg.val : UINT32_MAX;
+  retained.hostInterrupt = clockOn ? USB_DWC.gintsts_reg.val : UINT32_MAX;
+  retained.phyRoute = RTCCNTL.usb_conf.val;
+  retained.usbSerial = USB_SERIAL_JTAG.conf0.val;
+  uint8_t mux[2]{};
+  if (metalio::read(metalio::EXPANDER, 2, mux, 2)) retained.muxOutput = mux[0] | (mux[1] << 8);
+  readPowerStatus(retained.powerLate);
+  finishDiagnostic(result);
+  UsbUvcStill::StopSession();
+  esp_log_set_vprintf(previousPrintf);
+  disconnected();
+  if (result == ESP_OK) retained.phase = 6;
+  finishDiagnostic(result);
+  return result;
+}
+}  // namespace freeink::metalio_camera
+
+extern "C" void freeink_camera_config_descriptor(uint16_t length) {
+  freeink::metalio_camera::retained.configDescriptorBytes = length;
+}
