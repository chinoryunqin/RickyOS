+// 78/uart-eth-modem: 0.6.1 (+ local: SendAtCollectUntil, NoSim keep-alive)
+
+#pragma once
+
+#include <atomic>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <string>
+
+#include "driver/gpio.h"
+#include "driver/uart.h"
+#include "uart_uhci.h"
+#include "esp_err.h"
+#include "esp_event.h"
+#include "esp_netif.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/event_groups.h"
+#include "freertos/queue.h"
