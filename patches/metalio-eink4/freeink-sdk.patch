diff --git a/libs/display/FreeInkDisplay/src/lut/MetalioUiGray.h b/libs/display/FreeInkDisplay/src/lut/MetalioUiGray.h
new file mode 100644
index 0000000000000000000000000000000000000000..9a594241b6e8d533d0c708dc84fb711c1c8b13de
--- /dev/null
+++ b/libs/display/FreeInkDisplay/src/lut/MetalioUiGray.h
@@ -0,0 +1,35 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace freeink::metalioUiGray {
+// Same four-tone quantization as the UI HAL; low nibble is the first pixel.
+inline uint8_t tone(const uint8_t* raster, size_t pixel) {
+  return (((raster[pixel / 2] >> ((pixel & 1) * 4)) & 15) + 2) / 5;
+}
+// Optical history stores the committed four-tone value, not intermediate
+// coverage. Four pixels per byte, low pair first; composition remains 4bpp.
+inline uint8_t historyTone(const uint8_t* packed, size_t pixel) { return (packed[pixel / 4] >> ((pixel & 3) * 2)) & 3; }
+inline void packHistory(const uint8_t* raster, uint8_t* packed, size_t pixels) {
+  for (size_t pixel = 0; pixel < pixels; pixel += 4) {
+    uint8_t value = 0;
+    for (unsigned i = 0; i < 4 && pixel + i < pixels; ++i) value |= tone(raster, pixel + i) << (i * 2);
+    packed[pixel / 4] = value;
+  }
+}
+enum class Plane { EndpointBw, EndpointOld, GrayLsb, GrayMsb };
+inline uint8_t selectors(const uint8_t* next, const uint8_t* previous, size_t first, Plane plane) {
+  uint8_t result = 0;
+  for (unsigned bit = 0; bit < 8; ++bit) {
+    const auto target = tone(next, first + bit);
+    if (target == historyTone(previous, first + bit)) continue;
+    const bool set = plane == Plane::EndpointBw    ? target == 3
+                     : plane == Plane::EndpointOld ? target != 3
+                     : plane == Plane::GrayLsb     ? target == 1
+                                                   : target == 1 || target == 2;
+    if (set) result |= 0x80 >> bit;
+  }
+  return result;
+}
+}  // namespace freeink::metalioUiGray
