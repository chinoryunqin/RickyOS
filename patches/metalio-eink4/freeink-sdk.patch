--- /dev/null
+++ b/libs/hardware/MetalioCamera/src/CameraPower.h
@@ -0,0 +1,15 @@
+#pragma once
+#include <BoardConfig.h>
+#include <MetalioEink4Board.h>
+#include <Wire.h>
