diff --git a/libs/hardware/MetalioCamera/include/MetalioCamera.h b/libs/hardware/MetalioCamera/include/MetalioCamera.h
new file mode 100644
index 0000000000000000000000000000000000000000..d1a3627bf8f0579b3cef54ad1224cc2f6ea57f6d
--- /dev/null
+++ b/libs/hardware/MetalioCamera/include/MetalioCamera.h
@@ -0,0 +1,30 @@
+#pragma once
+#include <esp_err.h>
+
+#include <cstdint>
+
+#include "../src/usb_uvc_still.h"
+
+namespace freeink::metalio_camera {
+// Retained across software reset, so diagnostics survive the USB mux handoff.
+// phase: 1 power, 2 mux, 3 enumeration, 4 formats, 5 frame, 6 parked.
+struct Diagnostic {
+  uint32_t phase;
+  uint32_t configDescriptorBytes;
+  uint8_t powerBefore[5], powerAfter[5];
+  char usbError[256];
+  uint32_t hostPort, hostInterrupt, phyRoute, usbSerial;
+  uint16_t muxOutput;
+  uint8_t powerLate[5];
+  int result;
+  uint32_t internalBefore, internalAfter, largestBefore, largestAfter;
+};
+Diagnostic diagnostic();
+void recoverSerialRoute();
+using UsbBusyProbe = bool (*)();
+void setUsbBusyProbe(UsbBusyProbe probe);
+esp_err_t capture(UsbUvcStill::JpegBuffer& jpeg, UsbUvcStill::DetectInfo& info);
+// Host/PHY are kept until a controlled reset, with the camera physically
+// disconnected. Boot restores the USB mux before the application starts.
+bool needsRestart();
+}  // namespace freeink::metalio_camera
