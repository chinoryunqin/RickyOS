diff --git a/libs/hardware/MetalioCamera/src/CameraPower.cpp b/libs/hardware/MetalioCamera/src/CameraPower.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8d0b4924911c57122adaf6e0d2b2698a5b22136d
--- /dev/null
+++ b/libs/hardware/MetalioCamera/src/CameraPower.cpp
@@ -0,0 +1,92 @@
+// CX25601N fields and sequencing: CloudZao Metalio-E-INK4 d12f481f,
+// main/boards/common/power/cx25601n.cc:292-344,527-570. MIT; see LICENSE.CloudZao.
+#include "CameraPower.h"
+
+#include <esp_log.h>
+#if CONFIG_IDF_TARGET_ESP32S3
+#include <hal/usb_serial_jtag_ll.h>
+#endif
+
+namespace freeink::metalio_camera {
+namespace {
+constexpr uint8_t registers[] = {0x0a, 0x0b, 0x0c, 0x0d, 0x16, 0x18, 0x15};
+constexpr uint32_t kMagic = 0x43414d35;
+struct PowerSnapshot {
+  uint32_t magic, inverse;
+  uint8_t values[7];
+};
+RTC_NOINIT_ATTR PowerSnapshot saved;
+RTC_NOINIT_ATTR uint32_t routeMagic, routeInverse;
+constexpr uint32_t kRouteMagic = 0x55564334;
+bool write(uint8_t reg, uint8_t value) {
+  Wire.beginTransmission(metalio::CHARGER);
+  Wire.write(reg);
+  Wire.write(value);
+  return Wire.endTransmission() == 0;
+}
+bool update(uint8_t reg, uint8_t mask, uint8_t value) {
+  uint8_t old = 0;
+  return metalio::read(metalio::CHARGER, reg, &old, 1) && write(reg, (old & ~mask) | (value & mask));
+}
+bool savedValid() { return saved.magic == kMagic && saved.inverse == ~kMagic; }
+}  // namespace
+bool powerOff() {
+  if (!savedValid()) return true;
+  bool ok = update(0x18, 0x40, 0);  // remove camera VBUS before returning the USB PHY
+  delay(50);
+  for (size_t i = 0; i < sizeof(registers); ++i) ok = write(registers[i], saved.values[i]) && ok;
+  if (ok) saved.magic = 0;
+  return ok;
+}
+esp_err_t powerOn() {
+  if (!metalio::ready || savedValid()) return ESP_ERR_INVALID_STATE;
+  for (size_t i = 0; i < sizeof(registers); ++i)
+    if (!metalio::read(metalio::CHARGER, registers[i], &saved.values[i], 1)) return ESP_FAIL;
+  if (saved.values[5] & 0x40) return ESP_ERR_INVALID_STATE;  // another owner already uses OTG
+  saved.inverse = ~kMagic;
+  saved.magic = kMagic;
+  // 5040 mV / 80 = 63; 1000 mA / 20 = 50. Preserve unrelated register bits.
+  const bool ok = update(0x15, 0x40, 0) && update(0x16, 0x33, 0) && update(0x0c, 0xc0, 0xc0) &&
+                  update(0x0d, 0x1f, 0x0f) && update(0x0a, 0xf0, 0x20) && update(0x0b, 0x0f, 0x03) &&
+                  update(0x18, 0x40, 0x40);
+  if (!ok) {
+    powerOff();
+    return ESP_FAIL;
+  }
+  delay(40);  // vendor specifies at least 30 ms for boost entry
+  ESP_LOGI("CameraPower", "camera VBUS enabled; original charger registers retained");
+  return ESP_OK;
+}
+void readPowerStatus(uint8_t values[5]) {
+  constexpr uint8_t addresses[] = {0x15, 0x16, 0x18, 0x1e, 0x38};
+  for (size_t i = 0; i < 5; ++i) {
+    values[i] = 0xff;
+    metalio::read(metalio::CHARGER, addresses[i], values + i, 1);
+  }
+}
+bool selectCamera() {
+  routeInverse = ~kRouteMagic;
+  routeMagic = kRouteMagic;
+  return metalio::setOutput(metalio::output & ~metalio::USB_MUX_SEL);
+}
+void disconnected() {
+  // Disconnect the camera by removing VBUS while MUX remains LOW. This lets
+  // the hub observe removal before UVC free_all, without attaching a computer
+  // to the still-resident Host. The subsequent controlled restart restores MUX.
+  if (!powerOff()) ESP_LOGE("CameraPower", "charger restoration failed; retry at next boot");
+}
+}  // namespace freeink::metalio_camera
+
+namespace freeink::metalio_camera {
+void recoverSerialRoute() {
+#if CONFIG_IDF_TARGET_ESP32S3
+  // Hardware reset does not guarantee clearing the RTC PHY mux. Always set
+  // the startup route before board power/mux setup and before HWCDC.begin().
+  // Do not reset/gate USB here: its clock and FIFO may be owned by the ROM.
+  usb_serial_jtag_ll_phy_enable_external(false);
+  usb_serial_jtag_ll_phy_enable_pad(true);
+#endif
+  routeMagic = 0;
+}
+}  // namespace freeink::metalio_camera
+extern "C" bool freeink_metalio_recover_camera_power() { return freeink::metalio_camera::powerOff(); }
