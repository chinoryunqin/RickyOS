+{
+  "vendor_revision": "d12f481f4a42420634bb56a928f3959a977367d4",
+  "repository": "https://github.com/CloudZao/Metalio-E-INK4",
+  "input_sha256": {
+    "usb_uvc_still.cc": "07d47d7041b8c2d2bee75918b61d22dd5222c162c46317a60bf2a6809b0072fc",
+    "usb_uvc_still.h": "83c7f49b94304be53edd421aa44473892e967dcb5f7d19300f2e752e6e9ab6b4"
+  },
+  "changes": [
+    "No UI/cloud dependencies",
+    "PSRAM-only bounded JPEG copy",
+    "Disconnect camera via VBUS, retain LOW mux until controlled restart",
+    "Original charger registers restored and retained in RTC for reset recovery"
+  ]
+}
