diff --git a/libs/display/FreeInkDisplay/test/host/test_metalio_ui_retained.cpp b/libs/display/FreeInkDisplay/test/host/test_metalio_ui_retained.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2ccac7cfb7b55419ad4476adf68254d56dc73837
--- /dev/null
+++ b/libs/display/FreeInkDisplay/test/host/test_metalio_ui_retained.cpp
@@ -0,0 +1,141 @@
+#include <array>
+#include <cassert>
+#include <vector>
+
+#include "driver/CrossMuxSsd1677Driver.cpp"
+
+using namespace freeink;
+using Raster = std::array<uint8_t, 128>;
+using Bw = std::array<uint8_t, 32>;
+
+struct Paint {
+  std::vector<uint8_t> bw, old, lut;
+};
+std::vector<Paint> paints(const EpdBus& bus) {
+  Paint pending;
+  std::vector<Paint> result;
+  uint8_t control = 0;
+  for (const auto& event : bus.events) {
+    if (event.cmd == 0x24) pending.bw = event.bytes;
+    if (event.cmd == 0x26) pending.old = event.bytes;
+    if (event.cmd == 0x32) pending.lut = event.bytes;
+    if (event.cmd == 0x22) control = event.bytes.at(0);
+    if (event.cmd == 0x20 && (control & 4)) result.push_back(pending);
+  }
+  return result;
+}
+void put(Raster& raster, unsigned pixel, unsigned level) {
+  const unsigned shift = (pixel & 1) * 4;
+  raster[pixel / 2] = (raster[pixel / 2] & ~(15 << shift)) | (level << shift);
+}
+bool bit(const std::vector<uint8_t>& plane, unsigned pixel) { return plane.at(pixel / 8) & (0x80 >> (pixel % 8)); }
+Bw base(const Raster& raster) {
+  Bw bw{};
+  for (unsigned pixel = 0; pixel < raster.size() * 2; ++pixel) {
+    const unsigned value = (raster[pixel / 2] >> ((pixel & 1) * 4)) & 15;
+    if (value >= 13) bw[pixel / 8] |= 0x80 >> (pixel % 8);
+  }
+  return bw;
+}
+int main() {
+  EpdBus bus;
+  CrossMuxSsd1677Driver driver(crossmuxSsd1677MetalioConfig());
+  driver.begin(bus);
+  Raster raster;
+  raster.fill(0xff);
+  for (unsigned old = 0; old < 4; ++old)
+    for (unsigned target = 0; target < 4; ++target) put(raster, old * 4 + target, old * 5);
+  auto submit = [&](bool clean = false) {
+    const auto bw = base(raster);
+    return driver.displayUiGrayscale(bus, raster.data(), bw.data(), clean);
+  };
+  assert(submit());
+  assert(lastAllocationSize == raster.size() / 2);  // Four committed pixels per byte.
+  assert(paints(bus).size() == 3);                  // existing endpoint clean, base and gray
+  assert(driver.displayCommitted());
+  bus.clear();
+  assert(submit() && bus.events.empty());  // identical frames never flash
+  // All 16 source/target combinations; endpoints and both middle tones survive.
+  for (unsigned old = 0; old < 4; ++old)
+    for (unsigned target = 0; target < 4; ++target) put(raster, old * 4 + target, target * 5);
+  assert(submit());
+  auto p = paints(bus);
+  assert(p.size() == 2);
+  for (unsigned old = 0; old < 4; ++old) {
+    for (unsigned target = 0; target < 4; ++target) {
+      const unsigned pixel = old * 4 + target;
+      const bool changed = old != target;
+      assert(bit(p[0].bw, pixel) == (changed && target == 3));
+      assert(bit(p[0].old, pixel) == (changed && target != 3));
+      assert(bit(p[1].bw, pixel) == (changed && target == 1));
+      assert(bit(p[1].old, pixel) == (changed && (target == 1 || target == 2)));
+    }
+  }
+  for (unsigned pixel = 16; pixel < 256; ++pixel)
+    for (const auto& paint : p) assert(!bit(paint.bw, pixel) && !bit(paint.old, pixel));
+  // Uploaded pulse timing and analog bytes match the existing board LUT. Only
+  // the two unchanged selector classes are disabled in the endpoint pass.
+  for (unsigned i = 0; i < 105; ++i) {
+    const bool idle = i < 10 || (i >= 30 && i < 40);
+    assert(p[0].lut.at(i) == (idle ? 0 : lut_fast_metalio[i]));
+    assert(p[1].lut.at(i) == lut_grayscale[i]);
+  }
+  // Quantization-equivalent changes do not consume the cleanup budget.
+  bus.clear();
+  put(raster, 0, 1);
+  assert(submit() && bus.events.empty());
+  for (unsigned update = 0; update < 5; ++update) {
+    bus.clear();
+    put(raster, 24, (update & 1) ? 15 : 0);
+    assert(submit());
+    assert(paints(bus).size() == (update == 4 ? 3 : 2));
+  }
+  bus.clear();
+  assert(submit(true) && paints(bus).size() == 3);
+  bus.clear();
+  driver.requestResync(1);
+  assert(submit() && paints(bus).size() == 3);
+  // A non-UI page invalidates retained history even if it leaves valid gray.
+  bus.clear();
+  auto bw = base(raster);
+  driver.display(bus, bw.data(), nullptr, RefreshMode::Fast, false);
+  bus.clear();
+  assert(submit() && paints(bus).size() == 3);
+  bus.clear();
+  driver.deepSleep(bus);
+  driver.begin(bus);
+  bus.clear();
+  assert(submit() && paints(bus).size() == 3);
+  // No RAM writes after either failed delta activation. The next recovered
+  // transaction must clean, never reuse the failed frame as optical history.
+  for (unsigned phase = 1; phase <= 2; ++phase) {
+    bus.clear();
+    put(raster, 25, phase == 1 ? 0 : 15);
+    bus.failAt = bus.activation + phase;
+    assert(!submit());
+    assert(!driver.displayCommitted() && bus.busy);
+    assert(bus.events.back().cmd == -1);
+    bus.failAt = 0;
+    bus.busy = false;
+    bus.clear();
+    assert(submit() && paints(bus).size() == 3);
+  }
+  for (unsigned phase = 1; phase <= 3; ++phase) {
+    bus.clear();
+    bus.failAt = bus.activation + phase;
+    assert(!submit(true));
+    assert(!driver.displayCommitted() && bus.busy && bus.events.back().cmd == -1);
+    bus.failAt = 0;
+    bus.busy = false;
+    bus.clear();
+    assert(submit() && paints(bus).size() == 3);
+  }
+  {
+    CrossMuxSsd1677Driver unavailable(crossmuxSsd1677MetalioConfig());
+    bus.clear();
+    allocationFailAt = allocationCalls + 1;
+    assert(!unavailable.displayUiGrayscale(bus, raster.data(), bw.data(), false));
+    assert(bus.events.empty());
+    allocationFailAt = 0;
+  }
+}
