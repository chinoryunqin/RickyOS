--- /dev/null
+++ b/src/platform/PlusRecorderPreview.cpp
@@ -0,0 +1,35 @@
+#ifdef RICKYOS_SIMULATOR_PLUS
+#include <HalRecorder.h>
+#include <HalAudioOutput.h>
+#include <Arduino.h>
+#include <cstdio>
+#include <cstring>
+#include <array>
+namespace HalRecorder {
+static State current = State::Idle;
+static unsigned long started = 0;
+static uint32_t duration = 0;
+static std::array<Entry, 12> entries{};
+static size_t count = 0;
+bool active() { return current == State::Recording || current == State::Playing; }
+bool preparing() { return current == State::Recording && millis() - started < 1200; }
+uint32_t seconds() {
+  if (current == State::Recording) return preparing() ? 0 : (millis() - started - 1200) / 1000;
+  return active() ? (millis() - started) / 1000 : duration;
+}
+State state() { return current; }
+bool startRecording() { if(active()) return false; current=State::Recording; started=millis(); duration=0; return true; }
+bool play(const char* name, uint8_t) { if(active()) return false; for(size_t i=0;i<count;++i) if(!strcmp(name,entries[i].name)) { duration=entries[i].seconds; current=State::Playing; started=millis(); return true; } return false; }
+void stop() { if(current==State::Recording) { duration=seconds(); if(count<entries.size()) { auto& e=entries[count++]; snprintf(e.name,sizeof(e.name),"REC_20261013_1200%02u_00.wav",unsigned(count)); e.seconds=duration; } current=State::Saved; } else if(current==State::Playing) current=State::Idle; }
+void poll() { if(current==State::Playing && seconds()>=duration) current=State::Idle; }
+size_t list(size_t offset, Entry* out, size_t capacity, bool& more) { size_t n=0; while(offset+n<count && n<capacity) { out[n]=entries[offset+n]; ++n; } more=offset+n<count; return n; }
+}
+namespace HalAudioOutput {
+bool present() { return true; }
+bool preview(uint8_t) { return false; }
+bool playPcm(ReadCallback, SeekCallback, uint32_t, uint8_t, uint8_t) { return false; }
+bool restart(uint8_t) { return false; }
+void setVolume(uint8_t) {}
+void shutdown() { HalRecorder::stop(); }
+}
+#endif
--- /dev/null
+++ b/scripts/patch_plus_preview_clock.py
@@ -0,0 +1,8 @@
+from pathlib import Path
+Import('env')
+if env.subst('$PIOENV') == 'simulator_rickyos':
+    p = Path(env.subst('$PROJECT_LIBDEPS_DIR')) / 'simulator_rickyos/simulator/src/HalClock.h'
+    s = p.read_text()
+    if 'void cancelSync()' not in s:
+        assert s.count('  bool requestSync();') == 1
+        p.write_text(s.replace('  bool requestSync();', '  bool requestSync();\n  void cancelSync() { _syncState = ClockSyncState::Idle; }'))
