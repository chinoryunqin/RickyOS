+  assert(!activity.commitIme(0));
+  assert(activity.text.empty() && !strcmp(activity.ime.raw(), "nihao"));
+  activity.maxLength = 6;
+  assert(activity.commitIme(0));
+  assert(activity.text == "你好" && activity.ime.empty() && activity.cursorPos == 6);
+  assert(!activity.commitIme(99));
+}
+'''
