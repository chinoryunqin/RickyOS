+void encode(uint16_t cp, char* out) {
+  out[0] = static_cast<char>(0xe0 | (cp >> 12));
+  out[1] = static_cast<char>(0x80 | ((cp >> 6) & 63));
+  out[2] = static_cast<char>(0x80 | (cp & 63));
+  out[3] = 0;
+}
