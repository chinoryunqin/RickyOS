+  RickyDesignUi::softCard(renderer, r, selected && enabled);
+  const bool inverted = selected && enabled;
+  const auto tone = enabled ? ds::gray::kInk : ds::gray::kMute;
+  const int x = r.x + ds::space::kCardPadding;
