+
+void SkillGomokuActivity::flushSave() {
+  if (!dirty) return;
+  saveFailed = !store.save(game, versusComputer, cursor);
+  if (!saveFailed) {
+    dirty = false;
+    hasSave = true;
+  } else {
+    saveDue = millis() + 5000;
+  }
+}
