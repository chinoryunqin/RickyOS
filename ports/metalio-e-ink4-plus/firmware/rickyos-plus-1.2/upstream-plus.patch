+  best[bytes] = 0;
+  for (size_t at = length; at; at = previous[at]) {
+    const uint16_t token = tokens[at];
+    if (token & PHRASE_FLAG) {
+      const char* word = phrases[token & ~PHRASE_FLAG].text;
+      const size_t n = std::strlen(word);
+      bytes -= n;
+      std::memcpy(best + bytes, word, n);
