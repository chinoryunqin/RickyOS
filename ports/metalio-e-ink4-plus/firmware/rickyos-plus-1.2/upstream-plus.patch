+bool PinyinInput::nextPage() {
+  if (!more) return false;
+  skip += PAGE_SIZE;
+  refresh();
+  return true;
+}
+
+bool PinyinInput::previousPage() {
+  if (!skip) return false;
+  skip -= PAGE_SIZE;
+  refresh();
+  return true;
