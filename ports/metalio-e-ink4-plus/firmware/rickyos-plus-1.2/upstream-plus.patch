+  if (!Storage.ready() || !Storage.ensureDirectoryExists("/Recordings")) return false;
+  uint64_t total, free;
+  if (!Storage.getSpace(total, free) || free < 1024 * 1024) return false;
+  const time_t now = time(nullptr);
+  struct tm t{};
