+__attribute__((used, noinline)) void InputManager::pollMetalioPlusTouch(const unsigned long now) {
+  if (now < touchReadAt) return;
+  touchReadAt = now + 10;
+  uint8_t frame[5]{};
+  if (!metalio_i2c1_lock(20)) return;
+  const auto result = plus_i2c_read(BoardConfig::ACTIVE.touch.i2cAddress, 0x02, frame, sizeof(frame));
+  metalio_i2c1_unlock();
+  if (result != ESP_OK) return;
+  const unsigned count = frame[0] & 0x0f;
+  const auto releaseCover = [&] {
+    if (touchHomeKeyDown) touchHomeKeyTapEvent = !touchHomeKeyLongFired;
+    touchHomeKeyDown = false;
+    plusCoverButtons = 0;
+    plusCoverContact = false;
+  };
+  if (count == 0) { releaseTouch(now); releaseCover(); return; }
+  if (count > 2) return;
+  const unsigned event = frame[1] >> 6;
+  const uint16_t x = (static_cast<uint16_t>(frame[1] & 0x0f) << 8) | frame[2];
+  const uint16_t y = (static_cast<uint16_t>(frame[3] & 0x0f) << 8) | frame[4];
+  if (event == 1 || event == 3) { releaseTouch(now); releaseCover(); return; }
+  // OEM cover keys are off-panel FT6336 coordinates, before rotation/scaling.
+  const auto coverKey = plus_board::coverKeyAt(x, y);
+  if (coverKey != plus_board::CoverKey::None) {
+    releaseTouch(now);
+    if (!plusCoverContact) {
+      plusCoverContact = true;
+      if (coverKey == plus_board::CoverKey::Home) {
+        touchHomeKeyDown = true;
+        touchHomeKeyEvent = true;
+        touchHomeKeyLongFired = false;
+        touchHomeKeyDownAt = now;
+      } else if (coverKey == plus_board::CoverKey::Previous) plusCoverButtons = 1u << BTN_LEFT;
+      else if (coverKey == plus_board::CoverKey::Next) plusCoverButtons = 1u << BTN_RIGHT;
+    }
+    if (touchHomeKeyDown && !touchHomeKeyLongFired && now - touchHomeKeyDownAt >= 500) {
+      touchHomeKeyLongFired = true;
+      touchHomeKeyLongEvent = true;
+    }
+    return;
+  }
+  // A cover gesture remains a cover gesture until release; do not leak it as
+  // a screen tap or change keys when the finger slides between cover zones.
+  if (plusCoverContact) return;
+  if (event == 3 || x > 683 || y > 1215) { releaseTouch(now); return; }
+  updateTouchContact(mapTouchPoint(x, y, now));
